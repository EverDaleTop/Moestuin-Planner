[Unit]
Description=Moestuin Planner
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/moestuin-planner
ExecStart=/usr/bin/node --import tsx server/index.ts
Restart=always
RestartSec=3
Environment=PORT=3001
Environment=NODE_ENV=production
Environment=DATA_FILE=/opt/moestuin-planner/server/data/db.json
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
