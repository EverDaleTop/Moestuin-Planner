# ── Pluktuintje configuratie ─────────────────────────────────────
# Kopieer naar .env (backend) en zet frontend-vars in .env.local / .env

# Backend (server/index.ts)
PORT=3001
# Zonder Supabase: lokale JSON-file (default ./data/db.json)
# DATA_FILE=./data/db.json

# Supabase data-opslag (optioneel maar aanbevolen voor productie).
# Zet BEIDE en de server gebruikt Supabase i.p.v. de JSON-file.
# Zie supabase/schema.sql voor de tabellen (eenmalig uitvoeren).
SUPABASE_URL=https://jouw-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=jouw-service-role-key (alleen server! nooit in frontend)

# Supabase Auth verificatie (backend checkt Supabase-tokens hiermee)
SUPABASE_ANON_KEY=jouw-anon-key

# Google-login via Google Identity Services (directe GIS-knop, zonder Supabase).
# Maak een OAuth Client ID (type Web) in Google Cloud Console.
GOOGLE_CLIENT_ID=jouw-google-client-id.apps.googleusercontent.com

# ── Frontend (Vite: alleen VITE_-vars zijn zichtbaar in de browser) ─────────
# VITE_SUPABASE_URL=https://jouw-project.supabase.co
# VITE_SUPABASE_ANON_KEY=jouw-anon-key
# VITE_GOOGLE_CLIENT_ID=jouw-google-client-id.apps.googleusercontent.com

# Supabase Google-provider instellen:
#   Supabase Dashboard → Authentication → Providers → Google → Enabled
#   Redirect URI: https://jouw-project.supabase.co/auth/v1/callback
#   (Client ID + Secret uit Google Cloud Console plakken)
